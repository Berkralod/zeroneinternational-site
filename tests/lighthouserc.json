{
  "ci": {
    "collect": {
      "staticDistDir": "../dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/services/automation-bots/index.html",
        "http://localhost/tr/index.html",
        "http://localhost/ar/use-cases/stock-intake/index.html",
        "http://localhost/ja/contact/index.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "blockedUrlPatterns": [
          "*cloudflareinsights.com*"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "../lighthouse-report"
    }
  }
}
