# nginx configuration for the Railway deployment.
# ${PORT} is filled in by the nginx image's envsubst step when the container starts.

include /etc/nginx/snippets/languages.conf;

# Keep the temporary *.railway.app address out of search engines; the real domain is indexed.
map $http_host $zerone_robots {
    default "";
    ~*\.railway\.app$ "noindex, nofollow";
}

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;
    server_tokens off;
    absolute_redirect off;
    autoindex off;
    disable_symlinks on;
    client_max_body_size 16k;

    gzip on;
    gzip_vary on;
    gzip_min_length 512;
    gzip_types text/css application/javascript application/json application/manifest+json application/xml image/svg+xml text/plain;

    error_page 404 $zerone_not_found;

    # Old URLs of the previous site (generated by build.py)
    include /etc/nginx/snippets/redirects.conf;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Never serve hidden files (except .well-known/security.txt)
    location ~ /\.(?!well-known/) {
        return 404;
    }

    # Fingerprinted CSS and JS never change: cache for a year.
    location ~* "^/assets/.+\.[0-9a-f]{10}\.(?:css|js)$" {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=604800" always;
        try_files $uri =404;
    }

    location / {
        limit_except GET HEAD { deny all; }
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
        try_files $uri $uri/ =404;
    }
}
